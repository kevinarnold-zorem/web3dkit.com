HOST=127.0.0.1
PORT=8765
PUBLIC_URL=http://127.0.0.1:8765
BACKEND_DATABASE_PATH=data/web3dkit.sqlite
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters

# Desarrollo local: devuelve el OTP en la respuesta y habilita checkout simulado.
AUTH_DEV_EXPOSE_OTP=false
BACKEND_DEV_CHECKOUT=false

# Google OAuth. Callback autorizado: ${PUBLIC_URL}/api/backend/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo de cPanel (recomendado). SMTP_SECURE=true usa TLS directo, normalmente puerto 465.
SMTP_HOST=mail.web3dkit.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@web3dkit.com
SMTP_PASSWORD=
EMAIL_FROM=Web3DKit <no-reply@web3dkit.com>

# Alternativa opcional: webhook propio, POST {to, code, purpose, product}.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# Stripe opcional para checkout y portal reales.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=
